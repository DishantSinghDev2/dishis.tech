# SMTP settings for the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dishis.tech

# Cloudflare Turnstile captcha (https://dash.cloudflare.com/?to=/:account/turnstile)
# Without these, Cloudflare's always-pass test keys are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
